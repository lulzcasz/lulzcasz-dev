{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    ":semanticCommits",
    ":semanticCommitTypeAll(build)"
  ],
  "timezone": "America/Sao_Paulo",
  "separateMultipleMajor": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchManagers": ["pep621"],
      "rangeStrategy": "bump",
      "matchDepTypes": ["project.dependencies", "project.optional-dependencies", "dependency-groups", "build-system.requires"],
      "groupName": "python dependencies"
    },
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "commitMessageAction": "update",
      "commitMessageTopic": "python",
      "commitMessageExtra": "to {{newVersion}}"
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "docker images"
    },
    {
      "matchManagers": ["npm"],
      "groupName": "node dependencies"
    },
    {
      "groupName": "node.js version",
      "matchManagers": ["npm", "dockerfile", "docker-compose"],
      "matchPackageNames": ["node"]
    },
    {
      "description": "Force ALL major updates to separate into individual package branches",
      "matchUpdateTypes": ["major"],
      "groupName": null
    },
    {
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "commitMessageAction": "refresh",
      "commitMessageTopic": "uv.lock"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "commitMessageAction": "refresh",
      "commitMessageTopic": "package-lock.json"
    }
  ]
}
